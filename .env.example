# این فایل را به .env کپی کن و مقادیر واقعی را بگذار.
# .env هرگز کامیت نمی‌شود (در .gitignore است).
# (اسکریپت deploy/install.sh این فایل را خودکار می‌سازد.)

# ── پنل وب ──
# رمز ورود به پنل — حداقل ۸ حرف، طولانی و سخت
PANEL_PASSWORD=
# آدرس و پورت پنل (پیش‌فرض: 127.0.0.1 و 8000 — فقط از داخل سرور / تونل SSH)
# PANEL_HOST=127.0.0.1
# PANEL_PORT=8000

# ── کلیدهای صرافی (فعلاً استفاده نمی‌شود؛ ربات فقط کاغذی است) ──
# هشدار امنیتی: وقتی در صرافی API Key می‌سازی:
#   - دسترسی «برداشت» (Withdraw) را حتماً خاموش کن
#   - IP سرورت را در لیست مجاز قرار بده
NOBITEX_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
